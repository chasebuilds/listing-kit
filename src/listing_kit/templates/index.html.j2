<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta name="theme-color" content="#8a3a1c">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath fill='%238a3a1c' d='M16 3 2 16h4v12h8v-8h4v8h8V16h4z'/%3E%3C/svg%3E">
<style>
{{ css | safe }}
</style>
</head>
<body>
<div class="wrap">
 <div class="pillnav">
  <b>{{ agent.name if agent else 'listing-kit' }}</b>
  <nav aria-label="Main">
   <a href="./" aria-current="page">Listings</a>
   {% if checker %}<a href="checker/">Wording checker</a>{% endif %}
   {% if agent and agent.email %}<a href="mailto:{{ agent.email }}">Contact</a>{% endif %}
  </nav>
 </div>
 <main>
  <section class="panel">
   <h1>{{ title }}</h1>
   {% if intro %}<p class="lede">{{ intro }}</p>{% endif %}
   {% if agent %}<p class="meta">{% if agent.brokerage %}{{ agent.brokerage }}{% endif %}{% if agent.phone %} | <a href="tel:{{ agent.phone_digits }}">{{ agent.phone }}</a>{% endif %}{% if agent.email %} | <a href="mailto:{{ agent.email }}">{{ agent.email }}</a>{% endif %}</p>{% endif %}
   {% if statuses|length > 1 %}
   <div class="row" role="group" aria-label="Filter by status" id="filters" hidden>
    <button type="button" class="btn" data-status="" aria-pressed="true">All ({{ items|length }})</button>
    {% for st in statuses %}<button type="button" class="btn ghost" data-status="{{ st.name }}" aria-pressed="false">{{ st.name }} ({{ st.count }})</button>{% endfor %}
   </div>
   {% endif %}
  </section>
  <div class="cards" id="cards">
   {% for it in items %}
   <article class="card" data-status="{{ it.status }}">
    <a class="cover" href="{{ it.slug }}/" aria-label="{{ it.title }}, {{ it.price }}, {{ it.status }}">
     <img src="{{ it.thumb }}" width="480" height="320" alt="Photo of {{ it.title }}" loading="{{ 'eager' if loop.first else 'lazy' }}" decoding="async">
    </a>
    <div>
     <span class="tag">{{ it.status }}</span>
     <h2><a href="{{ it.slug }}/">{{ it.title }}</a></h2>
     <p class="price">{{ it.price }}</p>
     <p class="meta">{{ it.beds }} bed | {{ it.baths }} bath | {{ it.sqft }} sq ft</p>
     <p class="meta">{{ it.address }}</p>
     {% if it.next_open %}<p class="meta oh" data-end="{{ it.next_open.end }}">Open house: {{ it.next_open.when }}</p>{% endif %}
     <p class="meta"><a href="{{ it.slug }}/">View listing</a> | <a href="{{ it.slug }}/flyer.html">Print flyer</a></p>
    </div>
   </article>
   {% endfor %}
   {% if checker %}
   <a class="card" href="checker/">
    <div>
     <span class="tag">tool</span>
     <h2>Fair-housing wording checker</h2>
     <p>Paste a listing description and see wording that can signal a preference based on a protected class, with a suggested rewrite. A writing aid, not legal advice.</p>
    </div>
   </a>
   {% endif %}
  </div>
 </main>
 <footer>{{ footer }}</footer>
</div>
<script>
(function () {
  var box = document.getElementById('filters');
  var cards = document.querySelectorAll('#cards article');
  if (box) {
    box.hidden = false;
    box.addEventListener('click', function (e) {
      var b = e.target.closest('button');
      if (!b) return;
      var want = b.getAttribute('data-status');
      box.querySelectorAll('button').forEach(function (x) {
        var on = x === b;
        x.setAttribute('aria-pressed', on ? 'true' : 'false');
        x.className = on ? 'btn' : 'btn ghost';
      });
      cards.forEach(function (c) { c.hidden = !!want && c.getAttribute('data-status') !== want; });
    });
  }
  document.querySelectorAll('.oh[data-end]').forEach(function (p) {
    if (new Date(p.getAttribute('data-end')).getTime() < Date.now()) p.hidden = true;
  });
})();
</script>
</body>
</html>
