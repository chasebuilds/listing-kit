<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Flyer: {{ title }} | {{ address_line }}</title>
<meta name="robots" content="noindex">
<style>
:root{--accent:{{ accent }};--accent-ink:{{ accent_ink }};--link:{{ link }}}
*{box-sizing:border-box}
body{margin:0;background:#e9e9e9;color:#111;font:11pt/1.45 system-ui,-apple-system,"Segoe UI",Arial,sans-serif}
.bar{display:flex;gap:10px;justify-content:center;padding:12px;background:#fff;border-bottom:1px solid #ccc}
.bar a,.bar button{min-height:44px;padding:.5rem 1.1rem;border-radius:6px;border:2px solid var(--link);background:var(--accent);color:var(--accent-ink);font:inherit;font-weight:600;text-decoration:none;cursor:pointer}
.bar a{background:#fff;color:var(--link)}
.sheet{width:8.5in;max-width:100%;margin:16px auto;background:#fff;padding:.45in;box-shadow:0 2px 12px rgba(0,0,0,.2)}
.head{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:4px solid var(--accent);padding-bottom:10px;margin-bottom:12px;gap:12px}
.head h1{margin:0;font-size:24pt;line-height:1.1}
.head .addr{margin:2px 0 0;color:#333}
.price{font-size:22pt;font-weight:800;white-space:nowrap;margin:0}
.status{display:inline-block;background:var(--accent);color:var(--accent-ink);padding:1px 10px;border-radius:99px;font-weight:700;font-size:9pt}
.hero img{width:100%;height:3.4in;object-fit:cover;display:block}
.thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:6px 0 12px}
.thumbs img{width:100%;height:1.15in;object-fit:cover;display:block}
.facts{display:flex;gap:0;border:1px solid #bbb;margin:0 0 12px;padding:0}
.facts div{flex:1;text-align:center;padding:6px;border-right:1px solid #bbb}
.facts div:last-child{border-right:0}
.facts dt{font-size:8pt;text-transform:uppercase;letter-spacing:.05em;color:#444}
.facts dd{margin:0;font-size:14pt;font-weight:700}
.cols{display:grid;grid-template-columns:1.5fr 1fr;gap:20px}
h2{font-size:11pt;text-transform:uppercase;letter-spacing:.06em;margin:0 0 4px;border-bottom:1px solid #999}
p{margin:0 0 8px}
ul{margin:0 0 10px;padding-left:1.1rem}
.oh{list-style:none;padding:0}
.oh li{margin-bottom:6px}
.agent{border:2px solid var(--accent);padding:10px;margin-top:6px}
.fine{font-size:8pt;color:#444;margin-top:12px}
@media (max-width:700px){.cols{grid-template-columns:1fr}.head{flex-direction:column;align-items:flex-start}}
@page{size:letter;margin:0}
@media print{body{background:#fff;-webkit-print-color-adjust:exact;print-color-adjust:exact}.bar{display:none}.sheet{margin:0;box-shadow:none;width:auto;padding:.4in}}
</style>
</head>
<body>
<div class="bar"><button type="button" id="print">Print this flyer</button><a href="index.html">Back to the listing</a></div>
<div class="sheet">
 <div class="head">
  <div><span class="status">{{ status }}</span><h1>{{ title }}</h1><p class="addr">{{ address_line }}</p></div>
  <p class="price">{{ price_fmt }}</p>
 </div>
 <div class="hero"><img src="{{ photos[0].w1280 }}" width="{{ photos[0].w }}" height="{{ photos[0].h }}" alt="{{ photos[0].alt }}"></div>
 {% if photos|length > 1 %}
 <div class="thumbs">{% for p in photos[1:4] %}<img src="{{ p.w640 }}" alt="{{ p.alt }}">{% endfor %}</div>
 {% endif %}
 <dl class="facts">
  <div><dt>Beds</dt><dd>{{ beds }}</dd></div>
  <div><dt>Baths</dt><dd>{{ baths_fmt }}</dd></div>
  <div><dt>Sq ft</dt><dd>{{ sqft_fmt }}</dd></div>
  {% if year_built %}<div><dt>Built</dt><dd>{{ year_built }}</dd></div>{% endif %}
  {% if lot_sqft %}<div><dt>Lot sq ft</dt><dd>{{ lot_fmt }}</dd></div>{% endif %}
 </dl>
 <div class="cols">
  <div>
   <h2>About this home</h2>
   {% for para in paragraphs %}<p>{{ para }}</p>{% endfor %}
   {% if features %}<h2>Features</h2><ul>{% for f in features %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
  </div>
  <div>
   {% if open_houses %}<h2>Open house</h2><ul class="oh">{% for oh in open_houses %}<li><strong>{{ oh.when }}</strong>{% if oh.note %}<br>{{ oh.note }}{% endif %}</li>{% endfor %}</ul>{% endif %}
   <h2>Contact</h2>
   <div class="agent">
    <p><strong>{{ agent.name }}</strong>{% if agent.brokerage %}<br>{{ agent.brokerage }}{% endif %}{% if agent.license %}<br>{{ agent.license }}{% endif %}</p>
    {% if agent.phone %}<p>{{ agent.phone }}</p>{% endif %}
    <p>{{ agent.email }}</p>
   </div>
  </div>
 </div>
 {% if notice %}<p class="fine">{{ notice }}</p>{% endif %}
 <p class="fine">Equal Housing Opportunity. Information is believed accurate but not guaranteed; verify anything important.</p>
</div>
<script>document.getElementById("print").addEventListener("click",function(){window.print()})</script>
</body>
</html>
