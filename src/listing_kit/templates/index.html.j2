<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="Two invented sample listing pages made from one YAML file each, plus a fair-housing wording checker.">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="Two invented sample listing pages made from one YAML file each, plus a fair-housing wording checker.">
<meta name="theme-color" content="#8a3a1c">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath fill='%238a3a1c' d='M16 3 2 16h4v12h8v-8h4v8h8V16h4z'/%3E%3C/svg%3E">
<style>
{{ css | safe }}
</style>
</head>
<body>
<div class="wrap">
 <div class="pillnav">
  <b>listing-kit</b>
  <nav aria-label="Main">
   <a href="./" aria-current="page">Sample listings</a>
   {% if checker %}<a href="checker/">Wording checker</a>{% endif %}
   <a href="https://github.com/chasebuilds/listing-kit">GitHub</a>
  </nav>
 </div>
 <main>
  <section class="panel">
   <h1>One YAML file in, one listing website out</h1>
   <p class="lede">These two pages were generated from two small YAML files. The homes, people, addresses and photos are invented for the demo. Each page has a photo gallery, map, open house calendar file, payment estimate, contact form, share links and a print flyer.</p>
  </section>
  <div class="cards">
   {% for it in items %}
   <a class="card" href="{{ it.slug }}/">
    <img src="{{ it.thumb }}" width="480" height="320" alt="Photo of the sample home: {{ it.title }}" loading="lazy">
    <div>
     <span class="tag">{{ it.theme }} theme</span>
     <h2>{{ it.title }}</h2>
     <p class="price">{{ it.price }}</p>
     <p class="meta">{{ it.address }} (invented address)</p>
    </div>
   </a>
   {% endfor %}
   {% if checker %}
   <a class="card" href="checker/">
    <div>
     <span class="tag">tool</span>
     <h2>Fair-housing wording checker</h2>
     <p>Paste a listing description and see wording that can signal a preference based on a protected class, with a suggested rewrite. A writing aid, not legal advice.</p>
    </div>
   </a>
   {% endif %}
  </div>
 </main>
 <footer>Made with listing-kit by Chase Builds. MIT license.</footer>
</div>
</body>
</html>
